{
  "id": "gear-forge",
  "title": "Gear Forge",
  "description": "A d100 weapon tag table plus d20 shield and armour tables, for rolling up gear with a story. Written for Dragonbane; the 'what it is' half of every tag works in any system.",
  "version": "1.3.2",
  "authors": [
    {
      "name": "Captain Kabello"
    }
  ],
  "url": "https://github.com/Kabellosan/gear-forge",
  "manifest": "https://github.com/Kabellosan/gear-forge/releases/latest/download/module.json",
  "download": "https://github.com/Kabellosan/gear-forge/releases/download/v1.3.2/module.zip",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/gear-forge.css"
  ],
  "packs": [
    {
      "name": "tag-tables",
      "label": "Gear Forge — Tables",
      "path": "packs/tag-tables",
      "type": "RollTable",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "tag-rules",
      "label": "Gear Forge — Rules",
      "path": "packs/tag-rules",
      "type": "JournalEntry",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "tag-macros",
      "label": "Gear Forge — Macros",
      "path": "packs/tag-macros",
      "type": "Macro",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [
    {
      "name": "Gear Forge",
      "sorting": "m",
      "color": "#5a3a1a",
      "packs": [
        "tag-tables",
        "tag-rules",
        "tag-macros"
      ]
    }
  ]
}
